# 로컬 실행 설정 템플릿.
#
# 사용법: 이 파일을 application-local.yml로 복사한 뒤 값을 채운다.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# application-local.yml은 .gitignore 대상이라 커밋되지 않는다. 운영 값을 넣지 않는다.
# 기본값이 있는 설정(chat.cleanup, mail.async, file-deletion.async 등)은
# application.yml에 이미 있으므로 여기서 다시 쓰지 않는다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/todo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: ""
    password: ""

  jpa:
    hibernate:
      # 운영과 같은 validate를 쓴다. 스키마는 Flyway가 만들고 Hibernate는 대조만 한다.
      #
      # update로 두면 엔티티와 스키마가 어긋나도 Hibernate가 조용히 ALTER로 고쳐버려,
      # 로컬에서는 멀쩡한데 운영 배포에서 기동이 막히는 일이 생긴다. availability 시각
      # 컬럼이 TINYINT로 생성된 문제가 정확히 그렇게 드러났다.
      ddl-auto: validate
    show-sql: false

  # 이메일 인증·팀 초대 메일 발송용.
  mail:
    host: ""
    port: 587
    username: ""
    password: ""
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

# JWT 서명 키. HS256이라 최소 32바이트(영문 32자) 이상이어야 한다.
# 로컬 전용 임의 문자열이면 되고 운영 값과 달라도 된다.
# 만료 시간(jwt.expiration)은 application.yml에 이미 있다.
jwt:
  secret: ""

# S3 호환 오브젝트 스토리지(프로필·인증사진 업로드).
# presigned 만료·타임아웃은 MinioProperties의 기본값을 쓴다.
minio:
  endpoint: ""
  access-key: ""
  secret-key: ""
  region: us-east-1
  bucket: ""

# Swagger UI Basic 인증.
# application.yml이 ${SWAGGER_USERNAME}/${SWAGGER_PASSWORD} 환경변수를 참조하는데
# 로컬에는 보통 없으므로 여기서 직접 덮어쓴다. 없으면 기동이 실패한다.
swagger:
  auth:
    username: ""
    password: ""

# 아래는 기본값이 있어 생략 가능하다. 필요할 때만 주석을 푼다.
#
# app:
#   frontend-base-url: http://localhost:3000   # 초대 메일 링크 기준 URL
#
# todo:
#   scheduling:
#     enabled: false    # 로컬에서 만료·outbox 스케줄러를 돌리고 싶지 않을 때
